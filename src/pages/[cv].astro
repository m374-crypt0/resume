---
import type {MarkdownInstance} from 'astro'
import ResumeLayout from '../layouts/ResumeLayout.astro'
import Header from '../components/Header.astro'
import TableOfContents from '../components/TableOfContents.astro'

type Resume = MarkdownInstance<{title: string, author: string}>

// One page per src/content/resume-<slug>.md, served at /<slug>
export function getStaticPaths() {
  const resumes = import.meta.glob<Resume>('../content/resume-*.md', {eager: true})

  return Object.entries(resumes).map(([path, resume]) => ({
    params: {cv: path.match(/resume-(.+)\.md$/)![1]},
    props: {resume},
  }))
}

const {resume} = Astro.props
const {title, author: name} = resume.frontmatter
const headings = resume.getHeadings()
---

<ResumeLayout {title}>
  <TableOfContents {headings} />
  <Header {name} {title} />
  <div class="prose prose-lg max-w-4xl mx-auto px-6">
    <resume.Content />
  </div>
</ResumeLayout>
