---
import ResumeLayout from '../layouts/ResumeLayout.astro'
import Header from '../components/Header.astro'
import TableOfContents from '../components/TableOfContents.astro'
import {resumes} from '../lib/resumes'

// One page per src/content/resume-<slug>.md, served at /<slug>
export function getStaticPaths() {
  return resumes.map(({slug, resume}) => ({
    params: {cv: slug},
    props: {resume},
  }))
}

const {resume} = Astro.props
const {title, author: name} = resume.frontmatter
const headings = resume.getHeadings()
---

<ResumeLayout {title}>
  <TableOfContents {headings} />
  <Header {name} {title} />
  <div class="prose prose-lg max-w-4xl mx-auto px-6">
    <resume.Content />
  </div>
</ResumeLayout>
