---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import CvCard from '../components/CvCard.astro'
import TableOfContents from '../components/TableOfContents.astro'

import * as home from '../content/home.md'

const {title, author: name} = home.frontmatter
const headings = home.getHeadings()
const cvs = [
  {
    title: 'Senior C++ / Systems Engineer',
    description: 'C++ · Backend · Distributed Systems · Networking',
    href: '/system',
  },
  {
    title: 'Senior Technical Lead',
    description: 'Hands-on · Coaching · Technical Leadership',
    href: '/tech-lead',
  },
  {
    title: 'Blockchain / Smart Contract Engineer',
    description: 'EVM · Solidity · ZK · Foundry',
    href: '/web3',
  },
];
---

<BaseLayout {title}>
  <TableOfContents {headings} />
  <Header {name} {title} />
  <div class="prose prose-lg max-w-4xl mx-auto px-6">
    <home.Content />
  </div>

  <section>
    {cvs.map((cv) => (
      <CvCard {...cv} />
    ))}
  </section>
</BaseLayout>
