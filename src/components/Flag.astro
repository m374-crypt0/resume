---
import type {Flag} from '../lib/i18n'

type Props = {
  code: Flag
}

const {code} = Astro.props

// US flag, official proportions: 13 stripes, canton over 7 stripes, 50 stars
// on 9 alternating rows of 6 and 5
const stars = Array.from({length: 9}, (_, row) =>
  Array.from({length: row % 2 ? 5 : 6}, (_, col) => ({
    x: 247 * (2 * col + (row % 2 ? 2 : 1)),
    y: 210 * (row + 1),
  })),
).flat()
---

{code === 'us' && (
  <svg class="flag" viewBox="0 0 7410 3900" preserveAspectRatio="xMinYMid slice" aria-hidden="true">
    <rect width="7410" height="3900" fill="#b22234" />
    {[1, 3, 5, 7, 9, 11].map((i) => (
      <rect y={300 * i} width="7410" height="300" fill="#fff" />
    ))}
    <rect width="2964" height="2100" fill="#3c3b6e" />
    {stars.map(({x, y}) => (
      <circle cx={x} cy={y} r="120" fill="#fff" />
    ))}
  </svg>
)}

{code === 'fr' && (
  <svg class="flag" viewBox="0 0 3 2" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect width="1" height="2" fill="#002654" />
    <rect x="1" width="1" height="2" fill="#fff" />
    <rect x="2" width="1" height="2" fill="#ed2939" />
  </svg>
)}

<style>
  /* 4:3 box, like most flag icon sets; wider flags are cropped on the right */
  .flag {
    width: 1.25rem;
    height: 0.9375rem;
    flex-shrink: 0;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15);
  }
</style>
