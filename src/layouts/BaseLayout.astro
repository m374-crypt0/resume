---
import '../styles/global.css'
import LanguageSelector from '../components/LanguageSelector.astro'
import {defaultLang, languages, langs, localizePath, ui, unlocalizePath, type Lang} from '../lib/i18n'

type Props = {
  title: string,
  name: string,
  description: string,
  lang: Lang
}

const {title, name, description, lang} = Astro.props
const path = unlocalizePath(Astro.url.pathname)
// Titles already use ' — ' between role and specialty
const fullTitle = `${name} | ${title}`
const url = new URL(localizePath(lang, path), Astro.site)
// Link-preview card generated by src/pages/og/[lang]/[page].png.ts
const image = new URL(`/og/${lang}/${path === '/' ? 'home' : path.slice(1)}.png`, Astro.site)
---

<html {lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content={languages[lang].locale} />
    {langs.filter((other) => other !== lang).map((other) => (
      <meta property="og:locale:alternate" content={languages[other].locale} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />

    {langs.map((alternate) => (
      <link rel="alternate" hreflang={alternate} href={new URL(localizePath(alternate, path), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(defaultLang, path), Astro.site)} />
    <script is:inline>
      // Apply theme before first paint to avoid flash
      const stored = localStorage.getItem('theme')
      const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
      document.documentElement.dataset.theme = stored ?? preferred
    </script>
	</head>
	<body>
    <slot />

    <LanguageSelector {lang} {path} />

    <button
      id="theme-toggle"
      class="no-print fixed top-6 right-6 w-10 h-10 flex items-center justify-center rounded-full shadow-md cursor-pointer opacity-60 hover:opacity-100 transition-opacity"
      style="background-color: var(--color-border); color: var(--color-body);"
      aria-label={ui[lang].toggleTheme}>
      <!-- Sun: shown in dark mode -->
      <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
        <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
      <!-- Moon: shown in light mode -->
      <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/>
      </svg>
    </button>

    <script is:inline>
      const btn     = document.getElementById('theme-toggle')
      const sun     = document.getElementById('icon-sun')
      const moon    = document.getElementById('icon-moon')

      function applyTheme(theme) {
        document.documentElement.dataset.theme = theme
        localStorage.setItem('theme', theme)
        sun.style.display  = theme === 'dark'  ? 'block' : 'none'
        moon.style.display = theme === 'light' ? 'block' : 'none'
      }

      // Sync icons with current theme on load
      applyTheme(document.documentElement.dataset.theme)

      btn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
        applyTheme(next)
      })
    </script>
	</body>
</html>

